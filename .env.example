DATABASE_URL=postgresql+psycopg://guanlan:guanlan@localhost:5432/guanlan
REDIS_URL=redis://localhost:6379/0
# 行情源：tencent（默认，公开接口，无需密钥）或 mock（本地无行情时的演示回退）
QUOTE_SOURCE=tencent
# 只在 QUOTE_SOURCE=mock 时会改写价格。默认关闭。
DEMO_AUTO_PULSE=false
# 交易时段刷新间隔（秒）。调度器按这个间隔触发，非交易时段腾讯行情会降到下面的间隔。
SCAN_INTERVAL_SECONDS=4
OFFHOURS_SCAN_INTERVAL_SECONDS=60
API_INTERNAL_URL=http://127.0.0.1:18080

# 可选。留空时 AI 分析返回标明「演示」的结构化报告，不会请求模型。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Windows 本地没有 PostgreSQL 时可以用 SQLite（仍需要 Redis）：
# DATABASE_URL=sqlite:///./guanlan.db
